<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately NOT listed in GotIssues.slnx (T-0015 AC5). This tier starts real
    containers and builds real images; dragging it into `dotnet test` would make the
    habitual command minutes slow, which TESTING.md forbids. `tools/smoke.sh` is the
    one supported entry point, and it builds this project explicitly — nothing else
    compiles it, so it is the only thing standing between this project and rot.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
