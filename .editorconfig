# Formatting is settled by the formatter, not by review comments
# (project-os/standards/ENGINEERING.md). Run: dotnet format
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yaml,yml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_new_line_before_open_brace = all
csharp_indent_case_contents = true
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = false:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# EF Core writes migrations with a BOM, and only the .Designer/ModelSnapshot
# files carry an <auto-generated /> header — the migration itself does not.
# Without this, `dotnet format` reports CHARSET and IDE0161, and analyzers report
# things like CA1861, on files nobody may hand-edit — and it recurs on every
# `dotnet ef migrations add`. ENGINEERING.md: generated directories are excluded
# from analyzers and formatting checks.
#
# The glob covers every migrations directory, not just the API's: the identity
# host keeps its Duende store migrations under Migrations/{Configuration,Operational}.
[**/Migrations/**.cs]
generated_code = true

# Everything under libs/ is generated from spec/openapi.yaml by tools/generate.sh
# and is never hand-edited (ADR-0004). ENGINEERING.md excludes generated directories
# from analyzers and formatting checks; the analyzer half is in
# libs/Directory.Build.targets, and this is the formatting half.
[libs/**.cs]
generated_code = true

# Test projects. These analyzer rules describe good *library* code and fight
# idiomatic xUnit; the alternative is renaming tests into something less readable
# or bolting IDisposable onto classes whose lifetime xUnit already manages.
# Deliberately scoped to test projects only — production code keeps all three.
[apps/*Tests/**.cs]
# Test names read as sentences: Health_reports_unhealthy_when_... is the point.
dotnet_diagnostic.CA1707.severity = none
# Disposal is handled by xUnit's IAsyncLifetime, which the analyzer does not model.
dotnet_diagnostic.CA1001.severity = none
