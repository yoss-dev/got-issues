# Copy to .env and adjust. .env is git-ignored; never commit real credentials
# (project-os/standards/SECURITY.md). These are local development placeholders.

POSTGRES_USER=gotissues
POSTGRES_PASSWORD=replace-with-a-local-value
POSTGRES_DB=gotissues

# Host port the API is published on.
API_PORT=8080

# Identity host. These are local development client credentials for the two seeded
# identities — never real credentials, never a real person (T-0010 AC10).
IDENTITY_PORT=8081
IDENTITY_ISSUER_URI=http://localhost:8081
ADMIN_CLIENT_ID=gotissues-admin-client
ADMIN_CLIENT_SECRET=replace-with-a-local-value
MEMBER_CLIENT_ID=gotissues-member-client
MEMBER_CLIENT_SECRET=replace-with-a-local-value
